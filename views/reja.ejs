<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reja va Maqsadlar</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #b7b9cc;
        }

        .search-box {
            width: 73%;
            margin: 0 auto;
        }

        .clear-button {
            margin-left: 15%;
        }
    </style>
</head>

<body>

    <h1 class="text-center fw-normal mt-1 mb-2">
        REJA VA MAQSADLAR
    </h1>

    <div class="search-box ">
         <form id="create-form" action="/create-item" method="POST">
            <div class="bg-light rounded p-2 d-flex gap-2 align-items-center">
            
            <input
                type="text"
                name="item"
                class="form-control form-control-sm"
                placeholder="tekshirish"
            >

            <button class="btn btn-primary btn-sm rounded-pill text-nowrap">
                Yangi Reja Qo`shish
            </button>

        </div>
         </form>
    </div>

    <div class="clear-button">
        <button class="btn btn-danger btn-sm rounded-pill mt-4">
            Hamma rejalarni O`chirish
        </button>
    </div>

</body>
</html>
 